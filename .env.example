# Used by docker-compose. The agent container reaches your host's litellm proxy
# via host.docker.internal (Docker Desktop), not 127.0.0.1.
LLM_BASE_URL=http://host.docker.internal:4001/v1
LLM_API_KEY=changeme
LLM_MODEL=haiku

# STT (speaches) and TTS (Kokoro) run as local docker-compose services — no key needed.

# Your machine's LAN IP (`ipconfig` on Windows, `ip addr` on Linux/Mac). Needed so Asterisk
# advertises a reachable address in SDP — without it, Zoiper registers but hears no audio.
EXTERNAL_MEDIA_ADDRESS=192.168.1.100
